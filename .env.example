# SolSlip Environment Configuration
# Copy this file to .env and fill in your values

# Helius API Key for live swap parsing
# Get a free key at: https://dev.helius.xyz
HELIUS_API_KEY=

# Your deployed domain URL
# Used for Twitter share links and canonical URLs
SHARE_URL=https://solslip.app

# Solana RPC Endpoint
# Mainnet: https://api.mainnet-beta.solana.com
# Devnet:  https://api.devnet.solana.com
RPC_ENDPOINT=https://api.mainnet-beta.solana.com

# GitHub repository URL (optional)
# Used for the "View Source" link in header
GITHUB_REPO_URL=https://github.com/yourusername/solslip
